# Art packs are installed by `npm run assets:fetch` from assets/packs.json.
# Generated output: the manual (click-through) packs cannot be committed at all, so none are.
packages/client/public/models/

# Store packaging. There are two Android targets now — packaging/meta-quest (Horizon Store) and
# packaging/android-phone (Google Play) — and they generate byte-for-byte the same *kinds* of
# files, so these patterns are written against `packaging/*/` rather than named per target. A
# third target must not be able to leak a keystore by virtue of nobody remembering this file.
#
# twa-manifest.json is rendered per-environment by `npm run pack:quest` / `pack:phone` (it embeds
# one origin), and the signing key must never be committed: a store binds a listing to that key
# forever, so leaking it hands over the ability to publish updates as us.
packaging/*/twa-manifest.json
packaging/**/*.keystore
packaging/**/*.jks
packaging/**/*.apk
packaging/**/*.apk.idsig
packaging/**/*.aab
packaging/**/assetlinks.json

# The Android projects under packaging/ are generated by `bubblewrap update` from twa-manifest.json
# on every build. Committing them would mean reviewing a regenerated Gradle project on each domain
# change, and they would go stale the moment the manifest did.
packaging/*/app/
packaging/*/gradle/
packaging/*/gradlew
packaging/*/gradlew.bat
packaging/*/build.gradle
packaging/*/settings.gradle
packaging/*/gradle.properties
packaging/*/store_icon.png
packaging/*/manifest-checksum.txt
packaging/*/.gradle/
packaging/*/build/

# The Microsoft Store package. AppxManifest.xml carries the Partner Center identity, which is
# per-account and must not be committed; the tile art is regenerated from icons/icon-1024.png by
# `npm run pack:msstore`, so committing it would only let it drift from the source icon.
packaging/microsoft-store/build/
packaging/**/*.msix
packaging/**/*.msixbundle
packaging/**/*.appx
packaging/**/*.appxbundle
packaging/**/*.pfx
