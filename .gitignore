# Art packs are installed by `npm run assets:fetch` from assets/packs.json.
# Generated output: the manual (click-through) packs cannot be committed at all, so none are.
packages/client/public/models/

# Store packaging. Rendered per-environment by `npm run pack:quest` (it embeds one origin),
# and the signing key must never be committed: the store binds a listing to that key forever,
# so leaking it hands over the ability to publish updates as us.
packaging/meta-quest/twa-manifest.json
packaging/**/*.keystore
packaging/**/*.jks
packaging/**/*.apk
packaging/**/*.apk.idsig
packaging/**/*.aab
packaging/**/assetlinks.json

# The Android project under packaging/meta-quest is generated by `bubblewrap update` from
# twa-manifest.json on every build. Committing it would mean reviewing a regenerated Gradle
# project on each domain change, and it would go stale the moment the manifest did.
packaging/meta-quest/app/
packaging/meta-quest/gradle/
packaging/meta-quest/gradlew
packaging/meta-quest/gradlew.bat
packaging/meta-quest/build.gradle
packaging/meta-quest/settings.gradle
packaging/meta-quest/gradle.properties
packaging/meta-quest/store_icon.png
packaging/meta-quest/manifest-checksum.txt
packaging/meta-quest/.gradle/
packaging/meta-quest/build/
