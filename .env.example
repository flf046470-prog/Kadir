# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string.
DATABASE_URL=postgres://fiorematch:CHANGE_ME@127.0.0.1:5432/fiorematch_dev

# Optional: connection pool size (default 10).
# DATABASE_POOL_MAX=10

# Public base URL, used for canonical URLs and referral links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Photo storage.
#
# Unset, photos are written to local disk under .storage — fine for development
# and a single box, wrong for anything serverless, where the filesystem is
# per-request and vanishes between them.
#
# Naming a bucket switches to S3. The same settings work for AWS S3,
# Cloudflare R2, Backblaze B2 and MinIO; only the endpoint differs. The bucket
# must stay private: photos are served through /api/photos so moderation is
# checked on every read.
# S3_BUCKET=fiorematch-photos
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Omit for AWS; set for R2 (https://<account>.r2.cloudflarestorage.com) or MinIO.
# S3_ENDPOINT=
# Defaults to true when S3_ENDPOINT is set, false for AWS. Override if needed.
# S3_FORCE_PATH_STYLE=

# Live message translation.
#
# Off unless a provider is named. Translating a message means sending what two
# people wrote to each other to a third party, so this is never on by default,
# and the conversation shows the original underneath the translation.
# TRANSLATE_PROVIDER=deepl
# DEEPL_API_KEY=
# Derived from the key (a ":fx" suffix means the free tier). Override only for
# a proxy.
# DEEPL_API_HOST=

# The mobile app.
#
# Which deploy the Capacitor shell loads. Read at `npx cap sync` time, not at
# runtime — changing it means re-syncing and rebuilding the native project.
# CAPACITOR_SERVER_URL=https://fiorematch.com

# Deep links: /.well-known/assetlinks.json and /apple-app-site-association are
# 404 until these are set. That is deliberate — Android caches a *failed*
# verification, so a placeholder that does not match the real signing
# certificate is worse than serving nothing at all.
#
# SHA-256 fingerprints of the Android signing certificates, comma-separated.
# With Play App Signing there are two: your upload key, and the app-signing key
# Google shows under Release > Setup > App signing. List both, or half your
# installs fall back to the "open with" chooser.
#   keytool -list -v -keystore <release.keystore> -alias <alias>
# ANDROID_CERT_FINGERPRINTS=

# Apple Developer Team ID, from the membership page. Pairs with the bundle ID
# in capacitor.config.ts to form the app ID in apple-app-site-association.
# APPLE_TEAM_ID=

# Whether the marketing site is served to the public.
#
# FioreMatch ships as a mobile app; the deployment behind it exists to serve
# that app. Set to "off" and the SEO tree — location pages, guides, feature
# pages — stops answering, crawlers are told to stay out, the sitemap empties,
# and the root becomes a page pointing at the stores.
#
# A switch rather than a deletion: those pages are real work and the decision
# not to publish them can reverse. Public unless a deployment says otherwise.
#
# Always reachable either way: /legal/privacy and /legal/terms (Play refuses a
# listing without a public privacy URL), plus sign-in and registration, because
# a referral or notification link can land there on a device with no app.
# PUBLIC_SITE=off

# Overrides the canonical origin. Useful when the app-serving deployment lives
# on its own host — app.fiorematch.com, say — rather than the bare domain.
# SITE_URL=https://app.fiorematch.com
