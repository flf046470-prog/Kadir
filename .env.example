# ─── Site ─────────────────────────────────────────────────────────────────
# Canonical origin, used for canonical tags, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://example.com

# Where the SQLite file lives. Point this at a persistent volume in production.
DATABASE_PATH=./data/patagonia.db

# Secret used to hash client IPs for rate limiting. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Admin ────────────────────────────────────────────────────────────────
# The first admin account is created from these on first login.
# Generate the hash with: npm run admin:password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Development only — a plain password is hashed on first use. Prefer the hash.
# ADMIN_PASSWORD=

# ─── Email list (optional) ────────────────────────────────────────────────
# "log" (default) keeps sign-ups in the database only and logs the outbound leg.
# "resend" also pushes contacts to a Resend audience.
EMAIL_PROVIDER=log
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# ─── Financial support (optional, off by default) ─────────────────────────
# Support stays closed unless BOTH are set. The secret key is read server-side
# only and never reaches the browser.
SUPPORT_ENABLED=false
STRIPE_SECRET_KEY=
SUPPORT_CURRENCIES=USD,EUR,ARS
SUPPORT_AMOUNTS=10,25,50,100

# ─── Airbnb (optional) ────────────────────────────────────────────────────
# Leave empty until a real listing exists. Setting it turns on the booking
# button; while it is empty the site says reservations are not open.
AIRBNB_URL=
