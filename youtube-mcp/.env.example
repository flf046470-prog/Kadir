# Copy to .env for local runs only. NEVER commit a filled-in copy.
# In production these are set as encrypted environment variables in the
# hosting provider's dashboard — not in any file.

# From Google Cloud console > APIs & Services > Credentials
# ("ScareWithin YouTube MCP — Web application" client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32+ random bytes used to seal OAuth codes and tokens.
# Generate with:  openssl rand -base64 48
TOKEN_SECRET=

# Optional. Defaults to https://<deployment-host>/oauth/google/callback
# Only set this if you serve the MCP behind a custom domain.
GOOGLE_REDIRECT_URI=

# Optional. Overrides the public base URL used for the OAuth issuer.
PUBLIC_BASE_URL=

# Optional hardening: set to 1 to hide and refuse every write tool.
MCP_READ_ONLY=

# Optional: set to 1 to also request the yt-analytics-monetary.readonly scope
# so revenue metrics become available. Requires reconnecting the connector.
ENABLE_REVENUE_ANALYTICS=
