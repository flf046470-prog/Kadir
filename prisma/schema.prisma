generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id          String       @id @default(cuid())
  name        String
  description String
  url         String
  donationUrl String
  target      Decimal      @db.Decimal(18, 2)
  currency    String       @db.VarChar(3)
  ownerEmail  String
  status      CampaignStatus @default(DRAFT)
  totalRaised Decimal      @default(0) @db.Decimal(18, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  donations   Donation[]
  posts       SocialPost[]
  reports     DailyReport[]
}

model Donation {
  id            String    @id @default(cuid())
  campaignId    String
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  paymentId     String    @unique
  payment       Payment   @relation(fields: [paymentId], references: [id])
  amount        Decimal   @db.Decimal(18, 2)
  currency      String    @db.VarChar(3)
  donatedAt     DateTime
  status        DonationStatus @default(VERIFIED)
  donorName     String?
  donorEmail    String?
  createdAt     DateTime  @default(now())

  @@index([campaignId, donatedAt])
}

model Payment {
  id             String    @id @default(cuid())
  provider       String
  providerId     String    @unique
  amount         Decimal   @db.Decimal(18, 2)
  currency       String    @db.VarChar(3)
  status         PaymentStatus
  rawStatus      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  donation       Donation?
  events         PaymentEvent[]
}

model PaymentEvent {
  id            String   @id @default(cuid())
  provider      String
  eventId       String   @unique
  paymentId     String?
  payment       Payment? @relation(fields: [paymentId], references: [id])
  eventType     String
  signatureValid Boolean
  payloadHash   String
  receivedAt    DateTime @default(now())
  processedAt   DateTime?

  @@index([provider, receivedAt])
}

model SocialPost {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform    SocialPlatform
  body        String
  url         String?
  status      SocialPostStatus @default(DRAFT)
  consentedAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  channel   String
  recipient String
  kind      String
  body      String
  status    String   @default("pending")
  sentAt    DateTime?
  createdAt DateTime @default(now())
}

model DailyReport {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  reportDate  DateTime
  donationCount Int
  totalRaised Decimal @db.Decimal(18, 2)
  currency    String  @db.VarChar(3)
  createdAt   DateTime @default(now())

  @@unique([campaignId, reportDate])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum DonationStatus {
  VERIFIED
  REFUNDED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  X
}

enum SocialPostStatus {
  DRAFT
  APPROVED
  PUBLISHED
  REJECTED
}
