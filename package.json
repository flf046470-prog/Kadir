{
  "name": "fiorematch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:normalise-places": "tsx scripts/normalise-places.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "capture": "node scripts/capture.mjs",
    "native:assets": "node mobile/assets/generate.mjs",
    "native:sync": "cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "store:play": "node mobile/play-store/screenshots.mjs",
    "store:appstore": "node mobile/app-store/screenshots.mjs",
    "store:assets": "npm run store:play && npm run store:appstore && npm run store:microsoft",
    "store:microsoft": "node mobile/microsoft-store/screenshots.mjs",
    "store:microsoft:assets": "node mobile/microsoft-store/assets.mjs"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "$postcss"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@node-rs/argon2": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "^15.1.6",
    "next-intl": "^3.26.3",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "playwright": "^1.62.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
