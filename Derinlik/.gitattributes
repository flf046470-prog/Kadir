# Binary Unreal assets go through Git LFS (run `git lfs install` once)
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text
*.tga    filter=lfs diff=lfs merge=lfs -text
*.exr    filter=lfs diff=lfs merge=lfs -text
*.glb    filter=lfs diff=lfs merge=lfs -text
*.bat    text eol=crlf
# Small hand-made textures stay as normal git files (LFS uploads are not available from every environment)
SourceArt/Textures/T_FirstRecorderSigil.png !filter !diff !merge binary
